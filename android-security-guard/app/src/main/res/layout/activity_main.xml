<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#0D0D12" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="🛡 SecurityGuard" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:id="@+id/tvMonitorStatus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="⏸ Inactivo"
                android:textColor="#9E9E9E" android:textSize="13sp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:background="#1E1E2E" android:padding="16dp"
            android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Puntuación de seguridad" android:textColor="#9E9E9E" android:textSize="12sp"/>
                <TextView android:id="@+id/tvScoreLabel" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Calculando…"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"/>
            </LinearLayout>
            <TextView android:id="@+id/tvScore" android:layout_width="64dp" android:layout_height="64dp"
                android:text="--" android:textColor="#4CAF50" android:textSize="28sp"
                android:textStyle="bold" android:gravity="center" android:background="#2D2D2D"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="PERMISOS REQUERIDOS" android:textColor="#9E9E9E" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginBottom="6dp"/>

        <TextView android:id="@+id/badgeUsage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="❌ Uso de apps — requerido"
            android:textColor="#FFFFFF" android:textSize="13sp" android:padding="8dp"
            android:background="#1E1E2E" android:layout_marginBottom="4dp"/>
        <Button android:id="@+id/btnGrantUsage" android:layout_width="match_parent"
            android:layout_height="40dp" android:text="Activar acceso a uso de apps (obligatorio)"
            android:textSize="12sp" android:backgroundTint="#F44336" android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <TextView android:id="@+id/badgeCall" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="❌ Teléfono"
            android:textColor="#FFFFFF" android:textSize="13sp" android:padding="8dp"
            android:background="#1E1E2E" android:layout_marginBottom="4dp"/>
        <Button android:id="@+id/btnGrantPhone" android:layout_width="match_parent"
            android:layout_height="40dp" android:text="Conceder permiso de teléfono"
            android:textSize="12sp" android:backgroundTint="#FF9800" android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="12dp">
            <Button android:id="@+id/btnScan" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Escanear"
                android:textSize="13sp" android:backgroundTint="#7C4DFF" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnCallForward" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:layout_marginEnd="6dp" android:text="Desvío"
                android:textSize="13sp" android:backgroundTint="#E91E63" android:textColor="#FFFFFF"/>
            <Button android:id="@+id/btnAuditApps" android:layout_width="0dp" android:layout_height="52dp"
                android:layout_weight="1" android:text="Apps"
                android:textSize="13sp" android:backgroundTint="#009688" android:textColor="#FFFFFF"/>
        </LinearLayout>

        <ProgressBar android:id="@+id/progressScan" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp"
            android:indeterminate="true" android:indeterminateTint="#7C4DFF"
            android:visibility="gone" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="ALERTAS Y HALLAZGOS" android:textColor="#9E9E9E" android:textSize="11sp"
            android:textStyle="bold" android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvAlerts"
            android:layout_width="match_parent" android:layout_height="450dp"
            android:nestedScrollingEnabled="false"/>
    </LinearLayout>
</ScrollView>
