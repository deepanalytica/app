<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- File name -->
        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="archivo de audio"
            android:textColor="@color/textSecondary"
            android:textSize="12sp"
            android:ellipsize="marquee"
            android:singleLine="true"
            android:layout_marginBottom="12dp"/>

        <!-- Waveform -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:layout_marginBottom="16dp">

            <com.audioplayer.WaveformView
                android:id="@+id/waveformView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

            <ProgressBar
                android:id="@+id/progressLoading"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/primary"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- Hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Arrastra los marcadores verde (inicio) y rojo (fin) en la forma de onda, o usa los deslizadores:"
            android:textColor="@color/textSecondary"
            android:textSize="11sp"
            android:layout_marginBottom="12dp"/>

        <!-- Start SeekBar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="INICIO DEL CORTE"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/seekStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="0"
            android:progressTint="#4CAF50"
            android:thumbTint="#4CAF50"
            android:layout_marginBottom="16dp"/>

        <!-- End SeekBar -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FIN DEL CORTE"
            android:textColor="#F44336"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <SeekBar
            android:id="@+id/seekEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="1000"
            android:progressTint="#F44336"
            android:thumbTint="#F44336"
            android:layout_marginBottom="16dp"/>

        <!-- Time display -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/surface"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvStartTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Inicio: 0:00.0"
                android:textColor="#4CAF50"
                android:textSize="13sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvSegment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Duracion: 0:00.0"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <TextView
                android:id="@+id/tvEndTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Fin: 0:00.0"
                android:textColor="#F44336"
                android:textSize="13sp"
                android:textStyle="bold"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Export progress -->
        <ProgressBar
            android:id="@+id/progressExport"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/primary"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPreview"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Vista previa"
                android:textSize="14sp"
                android:backgroundTint="@color/surface"
                android:textColor="@color/white"/>

            <Button
                android:id="@+id/btnExport"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Guardar corte"
                android:textSize="14sp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
